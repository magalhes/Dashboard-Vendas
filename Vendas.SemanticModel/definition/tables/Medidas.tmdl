table Medidas
	lineageTag: d61c8d16-0d79-421e-8f2d-60ef037a66de

	/// Custo estimado das vendas, calculado linha a linha multiplicando o faturamento pelo percentual_custo da categoria do produto. Em R$.
	measure 'Custo Total' = ```
			SUMX(fVendas, fVendas[faturamento] * RELATED(dProdutos[percentual_custo]))
			
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Base
		lineageTag: 47d29667-7d60-4a50-ad9e-851de167c40a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Soma do faturamento de todas as vendas. Medida-base do modelo: Margem, % Atingimento e % Participação dependem dela. Em R$.
	measure 'Faturamento Total' = SUM(fVendas[faturamento])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Base
		lineageTag: 5fae71c4-a987-4e1b-98a6-809c8cfa96c5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Faturamento Total menos Custo Total, em R$.
	measure Margem = ```
			[Faturamento Total] - [Custo Total]
			
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Base
		lineageTag: 79f6abbb-a386-4297-b646-a9d5d804bbd0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Margem como percentual do Faturamento Total.
	measure '% Margem' = ```
			DIVIDE([Margem], [Faturamento Total])
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base
		lineageTag: 54e68714-d0de-4d2a-b793-fcd78d2f0dbd

	/// Soma das metas de vendas cadastradas por vendedor e mês. Em R$.
	measure 'Meta Total' = SUM(fMetas[valor_meta])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
