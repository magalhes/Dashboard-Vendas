	/// % Atingimento recalculado para o mês anterior ao filtro atual, via DATEADD sobre dCalendario.
	measure '% Atingimento Mês Anterior' = ```
			
			CALCULATE(
			    [% Atingimento],
			    DATEADD(dCalendario[Data], -1, MONTH)
			)
			
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Base
		lineageTag: 4111b61d-96ce-407f-bb33-713665554cea

	measure 'Cor Rótulo Atingimento MoM' = ```
			
			VAR vTemMesFiltrado = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a sua coluna de filtro de mês
			VAR vAtual = [% Atingimento]
			VAR vAnterior = [% Atingimento Mês Anterior]
			VAR vDiff = vAtual - vAnterior
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver um mês filtrado (filtro em "Todos"), retorna CINZA:
			        NOT vTemMesFiltrado, "#A3B5D9",
			
			        -- 2. Se não houver dado atual ou do mês anterior, retorna CINZA:
			        ISBLANK(vAtual) || ISBLANK(vAnterior), "#A3B5D9",
			        
			        -- 3. Variações (Crescimento / Queda):
			        vDiff > 0, "#22C55E", -- Verde
			        vDiff < 0, "#EF4444", -- Vermelho
			        
			        -- 4. Neutro / Zero
			        "#A3B5D9"            -- Cinza
			    )
			```
		displayFolder: Executiva\Cores
		lineageTag: 3d4212a9-a67f-4ecf-ac54-0070f5b4c3dc

	measure 'Faturamento Mês Anterior' =
			
			CALCULATE(
			    [Faturamento Total],
			    DATEADD('dCalendario'[Data], -1, MONTH)
			)
		displayFolder: Base
		lineageTag: 4214ffae-84cf-47d8-a5dc-0786cfa73419

