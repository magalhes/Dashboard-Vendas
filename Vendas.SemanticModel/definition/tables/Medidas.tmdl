	measure 'Rótulo Faturamento MoM' = ```
			
			VAR vTemMesFiltrado = HASONEVALUE(dCalendario[Mês]) -- Ajuste dCalendario[Mês] para a coluna do seu filtro se necessário
			VAR vAtual = [Faturamento Total]
			VAR vAnterior = [Faturamento Mês Anterior]
			VAR vVarPct = DIVIDE(vAtual - vAnterior, vAnterior)
			VAR vAbsPct = ABS(vVarPct)
			VAR vTextoBase = FORMAT(vAbsPct, "0.0%") & " vs mês anterior"
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver um mês individual filtrado, exibe a mensagem de sem comparação
			        NOT vTemMesFiltrado, "Sem comparação", -- (Dica: se preferir que não apareça nada, troque "Sem comparação" por BLANK())
			        
			        -- 2. Regras normais quando um mês estiver selecionado
			        ISBLANK(vAtual) || ISBLANK(vAnterior), "Não há dados",
			        vVarPct > 0, "▲ " & vTextoBase,
			        vVarPct < 0, "▼ " & vTextoBase,
			        "► 0.0% vs mês anterior"
			    )
			```
		displayFolder: Base\Rótulos
		lineageTag: 3eeb571a-6ae2-4215-a1c0-b7fdca4cfc12

	measure 'Cor Rótulo Faturamento MoM' = ```
			
			VAR vTexto = [Rótulo Faturamento MoM]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- Casos neutros / sem dados -> Cinza
			        vTexto = "Sem comparação" || 
			        CONTAINSSTRING(vTexto, "Não") || 
			        CONTAINSSTRING(vTexto, "dados"), "#A3B5D9",
			        
			        -- Crescimento -> Verde
			        CONTAINSSTRING(vTexto, "▲"), "#22C55E",
			        
			        -- Queda -> Vermelho
			        CONTAINSSTRING(vTexto, "▼"), "#EF4444",
			        
			        -- Padrão -> Cinza
			        "#85837B"
			    )
			```
		displayFolder: Base\Cores
		lineageTag: f2965cfa-e5b8-4770-947a-b4f2ec30cdf5

	/// Corrigido em 27/07: a versão anterior tinha sido reescrita copiando 'Rótulo Faturamento MoM' e esqueceram de trocar as variáveis — calculava a variação de [Faturamento Total] (-4,0% em nov/25) e rotulava como se fosse a variação de [% Atingimento], que na real subiu +2,3 p.p. (104,2%↞106,5%). Restaurada a lógica correta (diferença em p.p., não % relativo — atingimento é um percentual, comparar dois percentuais é diferença em p.p., não razão), mantendo o guard HASONEVALUE que foi adicionado depois (mostra 'Sem comparação' quando mais de 1 mês está selecionado).
	measure 'Rótulo Atingimento MoM' =
			IF(
			    NOT HASONEVALUE(dCalendario[Mês]),
			    "Sem comparação",
			    VAR vAtual = [% Atingimento]
			    VAR vAnterior = [% Atingimento Mês Anterior]
			    VAR vDiffPP = (vAtual - vAnterior) * 100
			    VAR vAbsDiff = ABS(vDiffPP)
			    VAR vTextoBase = FORMAT(vAbsDiff, "0.0") & " p.p. vs mês anterior"
			    RETURN
			        SWITCH(
			            TRUE(),
			            ISBLANK(vAtual) || ISBLANK(vAnterior), "Não há dados",
			            vDiffPP > 0, "▲ " & vTextoBase,
			            vDiffPP < 0, "▼ " & vTextoBase,
			            "► 0,0 p.p. vs mês anterior"
			        )
			)
		displayFolder: Executiva\Rótulos
		lineageTag: 5334b381-9b57-479d-b3dd-2dbcafb245d7

	/// Corrigido em 27/07: usava MAX(dCalendario[Data]) sem filtrar por venda real, pegando o fim do calendário (dez/26, sem nenhum dado) em vez do último mês real (jan/26) — dCalendario se estende até o fim do ano civil por construção. CALCULATE(MAX(...), fVendas) restringe às datas que têm pelo menos 1 linha de venda de verdade, via a relacionamento existente.
	measure 'Rótulo Mês Atual' =
			
			VAR vTemMesFiltrado = HASONEVALUE(dCalendario[Mês]) -- Ajuste dCalendario[Mês] para a coluna exata do seu filtro
			VAR vData = CALCULATE(MAX('dCalendario'[Data]), fVendas)
			VAR vMesAno = FORMAT(vData, "mmm/yy")
			
			RETURN
			    IF(
			        NOT vTemMesFiltrado,
			        "Visão geral", -- Ou troque por BLANK() se preferir deixar esse espaço totalmente limpo
			        IF(
			            ISBLANK(vData),
			            BLANK(),
			            "mês atual (" & LOWER(vMesAno) & ")"
			        )
			    )
		displayFolder: Executiva\Rótulos
		lineageTag: ea1bb4ed-5ce3-4afd-99f3-8ab3796071f5

	measure 'Cor Barra Meta' = ```
			
			VAR vFaturamento = [Faturamento Total]
			VAR vMeta = [Meta Total]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- Se não houver faturamento ou meta no mês, mantém a cor padrão (Azul)
			        ISBLANK(vFaturamento) || ISBLANK(vMeta), "#38BDF8",
			        
			        -- Se o faturamento for maior ou igual à meta, fica VERDE:
			        vFaturamento >= vMeta, "#22C55E",
			        
			        -- Caso contrário (não bateu a meta), fica AZUL:
			        "#38BDF8"
			    )
			```
		displayFolder: Executiva\Cores
		lineageTag: da7d7b66-fd85-491f-b8b8-6c24242eda54

	measure 'Cor Rótulo Meta Margem' =
			
			VAR vMargemAtual = [% Margem]
			VAR vMeta = 0.40 -- Valor da meta (40%)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(vMargemAtual), "#A0AEC0",          -- Cinza (sem dados)
			        vMargemAtual >= vMeta, "#22C55E",          -- Verde (atingiu a meta)
			        "#F59E0B"                                  -- Laranja/Âmbar (abaixo da meta)
			    )
		displayFolder: Base\Cores
		lineageTag: 469be696-8984-4010-8882-138ce82c8e4b

	/// Diferença entre % Margem e a meta interna de 40%, em pontos percentuais, com seta de direção. Retorna "Não há dados" quando % Margem não existe no contexto atual (ex.: categoria sem venda no período).
	measure 'Rótulo Margem vs Meta' = ```
			
			VAR vTemMesFiltrado = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a coluna do seu filtro de Mês
			VAR vMetaMargem = 0.4
			VAR vAtual = ROUND([% Margem], 4)
			VAR vDiffPP = (vAtual - vMetaMargem) * 100
			VAR vAbsDiff = ABS(vDiffPP)
			VAR vTextoBase = FORMAT(vAbsDiff, "0.00") & " p.p. vs meta (40%)"
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver um mês individual filtrado (filtro em "Todos"):
			        NOT vTemMesFiltrado, "Sem comparação", -- (troque por BLANK() se preferir deixar o espaço totalmente vazio)
			        
			        -- 2. Regras normais quando um mês estiver selecionado:
			        ISBLANK([% Margem]), "Não há dados",
			        vDiffPP > 0, "▲ " & vTextoBase,
			        vDiffPP < 0, "▼ " & vTextoBase,
			        "► 0,00 p.p. vs meta (40%)"
			    )
			```
		displayFolder: Base\Rótulos
		lineageTag: 936ff2db-9424-4fc9-bd76-6bace86b90e6

	/// Cor (hex) do "Rótulo Margem vs Meta": verde quando % Margem atinge a meta interna de 40%, âmbar quando fica abaixo, cinza quando não há dados no contexto atual.
	measure 'Cor Rótulo Margem vs Meta' =
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste para o nome da sua coluna de filtro de mês
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste para o nome da sua coluna de filtro de ano
			VAR vMetaMargem = 0.4
			VAR vAtual = ROUND([% Margem], 4)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver Mês E nem Ano selecionado (Visão geral / Sem comparação):
			        NOT (vTemMes || vTemAno), "#A3B5D9",
			
			        -- 2. Se a margem estiver em branco / sem dados:
			        ISBLANK([% Margem]), "#A3B5D9",
			
			        -- 3. Margem atingiu a meta (>= 40%):
			        vAtual >= vMetaMargem, "#22C55E", -- Verde
			
			        -- 4. Margem abaixo da meta (< 40%):
			        "#F59E0B" -- Laranja
			    )
		displayFolder: Base\Cores
		lineageTag: a759236e-86b5-41c7-aa1a-dd5fa99174d0

