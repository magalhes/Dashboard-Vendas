	measure 'Cor Dinamica Margem' =
			
			VAR vMargemAtual = [% Margem]
			
			-- Identifica a maior e a menor margem considerando os filtros de data/mês
			VAR vMaiorMargem = MAXX(ALLSELECTED(dProdutos[categoria_produto]), [% Margem])
			VAR vMenorMargem = MINX(ALLSELECTED(dProdutos[categoria_produto]), [% Margem])
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(vMargemAtual), "#334155",
			        vMargemAtual = vMaiorMargem, "#22C55E", -- Verde para a Campeã em Margem
			        vMargemAtual = vMenorMargem, "#EF4444", -- Vermelho para a Pior Margem
			        "#334155"                               -- Cinza Escuro para as intermediárias
			    )
		displayFolder: Produtos\Cores
		lineageTag: ce614f52-1ef0-4e11-a4e6-44debe9c32a2

	measure 'Subtitulo Alerta Margem' = ```
			
			VAR vPiorCategoriaTabela = 
			    TOPN(1, ALLSELECTED(dProdutos[categoria_produto]), [% Margem], ASC)
			
			VAR vNomePior = CALCULATE(SELECTEDVALUE(dProdutos[categoria_produto]), vPiorCategoriaTabela)
			VAR vValorPior = CALCULATE([% Margem], vPiorCategoriaTabela)
			
			RETURN
			    vNomePior & " tem a pior margem (" & FORMAT(vValorPior, "0%") & ")"
			```
