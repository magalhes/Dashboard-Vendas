	/// Faturamento Total dividido pela Meta Total. 100% = bateu a meta exata.
	measure '% Atingimento' = DIVIDE([Faturamento Total], [Meta Total])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base
		lineageTag: 88a58a11-aac6-456a-8dc0-251a25663a28

