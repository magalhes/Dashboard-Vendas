	measure 'Rótulo Faltante Meta' = ```
			
			VAR vTemMesFiltrado = HASONEVALUE(dCalendario[Mês]) -- Ajuste dCalendario[Mês] para a coluna exata do seu filtro de Mês
			VAR vMeta = [Meta Total]
			VAR vFat = [Faturamento Total]
			VAR vDiferenca = vMeta - vFat
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver um único mês filtrado (filtro em "Todos"):
			        NOT vTemMesFiltrado, "Sem comparação", -- (Dica: troque por BLANK() se preferir deixar o espaço vazio)
			        
			        -- 2. Regras normais quando um mês estiver selecionado:
			        ISBLANK(vMeta) || ISBLANK(vFat), BLANK(),
			        vDiferenca <= 0, "Meta batida! 🎉",
			        "Restante " & FORMAT(vDiferenca, "R$ #,##0")
			    )
			```
		displayFolder: Executiva\Rótulos
		lineageTag: ee8be3d5-fde1-4cfb-a5f1-c1c645da1849

	measure 'Rotulo Atingimento Equipe' = ```
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a coluna exata do seu filtro de mês
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste para a coluna exata do seu filtro de ano
			VAR vPct = [% Atingimento]
			VAR vDiff = ABS(1 - vPct)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver Mês E nem Ano selecionado (Visão Geral / Todos):
			        NOT (vTemMes || vTemAno), "Sem comparação",
			
			        -- 2. Se a porcentagem estiver em branco / sem dados:
			        ISBLANK(vPct), BLANK(),
			        
			        -- 3. Se atingiu ou superou 100%:
			        vPct >= 1, FORMAT(vDiff, "0.0%") & " acima da meta",
			        
			        -- 4. Se ficou abaixo de 100%:
			        FORMAT(vDiff, "0.0%") & " abaixo da meta"
			    )
			```
		displayFolder: Vendedores\Rótulos
		lineageTag: 226300e8-b0d9-42df-b677-9b2e4557aded

	/// Nome do vendedor com maior Faturamento Total no período filtrado. Vendedores sem faturamento ficam fora da disputa, então retorna BLANK quando não há venda nenhuma no período (antes nomeava um vendedor arbitrário). Espelha 'Nome Vendedor Atencao'.
	measure 'Nome Lider Periodo' =
			VAR vLiderTabela =
			    TOPN(
			        1,
			        FILTER(ALLSELECTED(dVendedores[nome_vendedor]), NOT ISBLANK([Faturamento Total])),
			        [Faturamento Total], DESC
			    )
			RETURN
			    CALCULATE(MAX(dVendedores[nome_vendedor]), vLiderTabela)
		displayFolder: Vendedores\Rótulos
		lineageTag: 22848f11-b74b-4f75-a659-88394b24345a

	/// % Atingimento do líder do período, como texto pronto pro rótulo de referência do card (ex.: "100% da meta"). Retorna "Não há dados" quando não há venda no período (antes devolvia a string órfã " da meta", sem número).
	measure 'Rotulo Lider Receita Label' = ```
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a coluna de filtro de mês
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste para a coluna de filtro de ano
			
			VAR vLiderNome = [Nome Lider Periodo]
			
			-- Busca o faturamento e % da meta do líder
			VAR vFat = CALCULATE([Faturamento Total], dVendedores[nome_vendedor] = vLiderNome)
			VAR vPct = CALCULATE([% Atingimento], dVendedores[nome_vendedor] = vLiderNome)
			
			-- Formatação do Faturamento (Milhões, Mil ou R$)
			VAR vFatText = 
			    SWITCH(
			        TRUE(),
			        ISBLANK(vFat) || vFat = 0, "R$ 0,0",
			        vFat >= 1000000, "R$ " & FORMAT(vFat / 1000000, "0.0") & " Mi",
			        vFat >= 1000, "R$ " & FORMAT(vFat / 1000, "0.0") & " Mil",
			        "R$ " & FORMAT(vFat, "#,##0")
			    )
			
			-- Formatação do % da Meta
			VAR vPctText = FORMAT(vPct, "0%") & " da meta"
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver Mês E nem Ano selecionado:
			        NOT (vTemMes || vTemAno), "Sem comparação",
			        
			        -- 2. Se não houver líder (sem dados):
			        ISBLANK(vLiderNome), BLANK(), 
			        
			        -- 3. Exibe o texto normal formatado:
			        vFatText & " · " & vPctText
			    )
			```
		displayFolder: Vendedores\Rótulos
		lineageTag: b00d559d-39f6-45f8-92bb-da9669e15b83

	/// Cor (hex) do rótulo 'Lider Pct Meta': verde quando o líder bateu 100%, âmbar quando ficou abaixo, cinza quando não há dados no período (antes pintava o 'Não há dados' de âmbar, cor de alerta).
	measure 'Cor Lider Receita Label' = ```
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a coluna de filtro de mês
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste para a coluna de filtro de ano
			
			VAR vLiderNome = [Nome Lider Periodo]
			VAR vPct = CALCULATE([% Atingimento], dVendedores[nome_vendedor] = vLiderNome)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver Mês E nem Ano selecionado (Visão Geral):
			        NOT (vTemMes || vTemAno), "#A3B5D9",
			        
			        -- 2. Sem dados / Em branco:
			        ISBLANK(vPct), "#A3B5D9",
			        
			        -- 3. Regras de cores conforme o atingimento:
			        vPct >= 1.00, "#22C55E", -- Verde (Meta Batida)
			        vPct >= 0.85, "#F59E0B", -- Laranja / Amarelo (Próximo da meta - ex: 99%)
			        "#EF4444"                -- Vermelho (Abaixo de 85%)
			    )
			```
		displayFolder: Vendedores\Cores
		lineageTag: 1f70e769-3365-4fde-8e34-3b144dc08d38

	measure 'Nome Vendedor Atencao' =
			VAR vPiorTabela =
			    TOPN(
			        1,
			        FILTER(ALLSELECTED(dVendedores[nome_vendedor]), NOT ISBLANK([% Atingimento])),
			        [% Atingimento], ASC
			    )
			RETURN
			    CALCULATE(MAX(dVendedores[nome_vendedor]), vPiorTabela)
		displayFolder: Vendedores\Rótulos
		lineageTag: 2eef032c-6c83-4f9f-bee8-6a46d4a04096

	/// Quanto faltou de meta para o vendedor em atenção (mesmo critério de 'Nome Vendedor Atencao': menor % Atingimento entre quem tem meta cadastrada no período filtrado). Texto pronto pro rótulo de referência do card, ex.: "14% abaixo da meta". Retorna "todos bateram a meta" quando até o pior vendedor superou 100% (acontece em jun/25 e nov/25).
	measure 'Rótulo Vendedor Atencao Pct Meta' = ```
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a sua coluna exata de Mês
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste para a sua coluna exata de Ano
			
			VAR vPiorTabela =
			    TOPN(
			        1,
			        FILTER(ALLSELECTED(dVendedores[nome_vendedor]), NOT ISBLANK([% Atingimento])),
			        [% Atingimento], ASC
			    )
			VAR vPct =
			    CALCULATE([% Atingimento], vPiorTabela)
			VAR vGap = 1 - vPct
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver Mês E nem Ano selecionado (Visão Geral):
			        NOT (vTemMes || vTemAno), "Sem comparação",
			        
			        -- 2. Sem dados para calcular:
			        ISBLANK(vPct), "Não há dados",
			        
			        -- 3. Caso o pior vendedor tenha superado 100%:
			        vGap <= 0, "todos bateram a meta",
			        
			        -- 4. Exibe a distância para a meta do pior vendedor:
			        FORMAT(vGap, "0%") & " abaixo da meta"
			    )
			```
		displayFolder: Vendedores\Rótulos
		lineageTag: 8d567da7-c880-46be-b485-574714d69cfc

	/// Corrigido em 27/07: o denominador contava TODOS os 12 vendedores cadastrados, mesmo os sem meta/venda no mês (% Atingimento em branco) — achado testando Mês=março, que mostrava '0 de 12' quando só 8 vendedores têm dado nesse mês (Estevan Souza, Julia Silva, Julieta Gomes e Mateus Costa ficam de fora). Agora usa a mesma tabela filtrada de 'Rótulo vendedores Abaixo Meta' (NOT ISBLANK([% Atingimento])), então os dois cartões sempre somam o mesmo total.
	measure 'Vendedores Bateram Meta Card' =
			VAR vTabelaVendedoresComDado =
			    FILTER(
			        VALUES(dVendedores[nome_vendedor]),
			        NOT ISBLANK([% Atingimento])
			    )
			VAR vTotalVendedores = COALESCE(COUNTROWS(vTabelaVendedoresComDado), 0)
			VAR vBateramMeta =
			    COALESCE(
			        COUNTROWS(
			            FILTER(
			                vTabelaVendedoresComDado,
			                [% Atingimento] >= 1
			            )
			        ),
			        0
			    )
			RETURN
			    vBateramMeta & " de " & vTotalVendedores
		displayFolder: Vendedores
		lineageTag: 72cc9fe1-bc38-4410-ac3b-ecdd16d70d50

	/// Corrigido em 27/07: a versão anterior fazia 'total - bateram', contando vendedor SEM meta/venda cadastrada no mês (% Atingimento em branco) como 'abaixo da meta'. Achado testando Mês=junho no relatório publicado: Julieta Gomes e Estevan Souza não têm dado em jun/25 (buraco de meta documentado), e apareciam como '2 ficaram abaixo' quando os 10 vendedores com dado bateram 100% a meta. Agora conta direto quem tem dado E ficou abaixo. COALESCE(...,0) necessário porque COUNTROWS de tabela vazia retorna BLANK nesse modelo, não 0 — sem isso o rótulo aparece sem o número (' ficaram abaixo').
	measure 'Rótulo vendedores Abaixo Meta' =
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a coluna exata do seu filtro de mês
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste para a coluna exata do seu filtro de ano
			
			VAR vTabelaVendedores = VALUES(dVendedores[nome_vendedor])
			VAR vAbaixo =
			    COALESCE(
			        COUNTROWS(
			            FILTER(
			                vTabelaVendedores,
			                NOT ISBLANK([% Atingimento]) && [% Atingimento] < 1
			            )
			        ),
			        0
			    )
			
			RETURN
			    IF(
			        NOT (vTemMes || vTemAno),
			        "Sem comparação",
			        vAbaixo & " ficaram abaixo"
			    )
		displayFolder: Vendedores\Rótulos
		lineageTag: 785f3bdc-6be0-41a6-a116-f00a72a2d27e

	measure 'Cor Label Atingimento Equipe' =
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste para a coluna exata do seu filtro de mês
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste para a coluna exata do seu filtro de ano
			VAR vPct = [% Atingimento]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver Mês E nem Ano selecionado (Visão Geral):
			        NOT (vTemMes || vTemAno), "#A3B5D9",
			
			        -- 2. Se não houver dados de atingimento:
			        ISBLANK(vPct), "#A3B5D9",
			
			        -- 3. Atingiu ou superou a meta (>= 100%):
			        vPct >= 1, "#22C55E", -- Verde
			
			        -- 4. Ficou abaixo da meta (< 100%):
			        "#F59E0B"             -- Laranja
			    )
		displayFolder: Vendedores\Cores
		lineageTag: 9a512704-4e12-44e1-998e-941debbd5f1a

	measure 'Cor Vendedor Atencao Pct Meta' = ```
			
			VAR vTemMes = HASONEVALUE(dCalendario[Mês]) -- Ajuste se o nome da coluna for diferente
			VAR vTemAno = HASONEVALUE(dCalendario[Ano]) -- Ajuste se o nome da coluna for diferente
			
			VAR vPiorTabela =
			    TOPN(
			        1,
			        FILTER(ALLSELECTED(dVendedores[nome_vendedor]), NOT ISBLANK([% Atingimento])),
			        [% Atingimento], ASC
			    )
			VAR vPct =
			    CALCULATE([% Atingimento], vPiorTabela)
			VAR vGap = 1 - vPct
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Se NÃO houver Mês E nem Ano selecionado (Visão Geral):
			        NOT (vTemMes || vTemAno), "#A3B5D9",
			        
			        -- 2. Sem dados:
			        ISBLANK(vPct), "#A3B5D9", 
			        
			        -- 3. Todos bateram a meta:
			        vGap <= 0, "#22C55E",      -- Verde
			        
			        -- 4. Abaixo da meta:
			        "#F59E0B"                  -- Vermelho
			    )
			```
		displayFolder: Vendedores\Cores
		lineageTag: d14ca237-9256-4edd-b976-e73efbb6a9d9

	/// Corrigido em 27/07 (2ª vez): faltava o mesmo CALCULATETABLE(..., ALL(dCalendario)) já aplicado em 'Atingimento Ultimo Mes'. Sem ele, o slicer de Mês/Ano da página filtrava VALUES(dCalendario[AnoMes]) pra só 1 mês, fazendo o subtítulo descrever ESSE mês como se fosse 'o mais recente da série' — achado testando Mês=junho no relatório publicado: mostrava 'Fecha jun/25 em 118,2% — o menor da série', quando jun/25 é na verdade o PICO da série inteira. Agora ignora slicers de período (mesmo trade-off já aceito na medida irmã): sempre descreve o último mês REAL do dataset inteiro, não o mês filtrado.
	measure 'Subtitulo Atingimento Mensal' =
			VAR vTabelaMeses =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES(dCalendario[AnoMes]),
			            "DataRef", CALCULATE(MIN(dCalendario[Data])),
			            "Pct", CALCULATE([% Atingimento])
			        ),
			        ALL(dCalendario)
			    )
			VAR vMesesComDado = FILTER(vTabelaMeses, NOT ISBLANK([Pct]))
			VAR vUltimaData = MAXX(vMesesComDado, [DataRef])
			VAR vUltimoPct = MAXX(FILTER(vMesesComDado, [DataRef] = vUltimaData), [Pct])
			VAR vMesTexto = LOWER(FORMAT(vUltimaData, "mmm/yy"))
			VAR vTabelaAnteriorMenor =
			    FILTER(vMesesComDado, [DataRef] < vUltimaData && [Pct] < vUltimoPct)
			VAR vDataRecorde = MAXX(vTabelaAnteriorMenor, [DataRef])
			VAR vDesdeTexto =
			    IF(
			        ISBLANK(vDataRecorde),
			        "o menor da série",
			        "menor desde " & LOWER(FORMAT(vDataRecorde, "mmm/yy"))
			    )
			RETURN
			    IF(
			        ISBLANK(vUltimaData),
			        "Não há dados",
			        "Fecha " & vMesTexto & " em " & FORMAT(vUltimoPct, "0.0%") & " — " & vDesdeTexto
			    )
		displayFolder: Vendedores\Rótulos
		lineageTag: 19126ab2-ef1f-48b7-bbc5-e0aeb26fb4fa

	measure 'Meta 100%' = 1.00
		displayFolder: Vendedores
		lineageTag: 18324f5b-ca7d-422b-bb6c-4d2972fbc24a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Rótulo Faltante Meta' = ```
			
			VAR vTexto = [Rótulo Faltante Meta]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- Casos neutros / sem dados -> Cinza
			        vTexto = "Sem comparação" || 
			        CONTAINSSTRING(vTexto, "Não") || 
			        CONTAINSSTRING(vTexto, "dados"), "#A3B5D9",
			        
			        -- Meta Batida -> Verde
			        CONTAINSSTRING(vTexto, "Meta batida"), "#22C55E",
			        
			        -- Valor Faltante (Restante) -> Vermelho
			        CONTAINSSTRING(vTexto, "Restante"), "#EF4444",
			        
			        -- Padrão -> Cinza
			        "#A3B5D9"
			    )
			```
		displayFolder: Executiva\Cores
		lineageTag: f0f826f7-0dc8-41b6-8040-39288f31e8a7

	measure 'Distancia Meta' =
			
			VAR vFat = [Faturamento Total]
			VAR vMeta = [Meta Total]
			RETURN
			    IF(
			        ISBLANK(vFat) && ISBLANK(vMeta),
			        BLANK(),
			        vFat - vMeta -- Ajustado: Faturamento menos Meta
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Vendedores
		lineageTag: 33c5f855-8b2b-489f-8876-9665f57b194a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Distancia %' =
			
			VAR vFat = [Faturamento Total]
			VAR vMeta = [Meta Total]
			VAR vPct = DIVIDE(vFat - vMeta, vMeta)
			
			RETURN
			    IF(
			        ISBLANK(vPct),
			        BLANK(),
			        FORMAT(vPct, "+0.00%;-0.00%;0.00%")
			    )
		displayFolder: Vendedores
		lineageTag: cef2e568-ae4c-4c08-8fd8-8bd2461da093

	measure 'Cor Distancia %' = ```
			
			VAR vFat = [Faturamento Total]
			VAR vMeta = [Meta Total]
			VAR vPct = DIVIDE(vFat - vMeta, vMeta)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1. Sem dados: Cinza
			        ISBLANK(vPct), "#A3B5D9",
			        
			        -- 2. Bateu ou superou a meta: Verde
			        vPct >= 0, "#22C55E",
			        
			        -- 3. Abaixo da meta: Amarelo
			        "#F59E0B"
			    )
			```
		displayFolder: Vendedores\Cores
		lineageTag: bf3d8231-eb6e-4dd0-b90e-845caccf36b1

