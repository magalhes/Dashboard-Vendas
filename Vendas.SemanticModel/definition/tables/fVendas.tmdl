	partition fVendas = m
		mode: import
		queryGroup: Bases
		source =
				let
				    Fonte = #"Base Matriz",
				    Vendas_Sheet = Fonte{[Item="Vendas",Kind="Sheet"]}[Data],
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Vendas_Sheet, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"data_venda", type date}, {"nfe", Int64.Type}, {"id_produto", Int64.Type}, {"id_vendedor", Int64.Type}, {"valor_unit", Currency.Type}, {"qtd", Int64.Type}, {"faturamento", type number}}),
				    #"Linhas Filtradas" = Table.SelectRows(#"Tipo Alterado", each [id_produto] <> null and [id_produto] <> "")
				in
				    #"Linhas Filtradas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

