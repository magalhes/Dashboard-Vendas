/// Fato principal · 1 linha = 1 item de produto vendido numa nota fiscal. Fonte: Base de Dados.xlsx, aba Vendas. 163.418 linhas.
table fVendas
	lineageTag: d5badd8f-6b40-4f73-bb1a-446ea0b1e9ae

	column data_venda
		dataType: dateTime
		formatString: Long Date
		lineageTag: 158fdd1f-8e0a-4d06-8d12-150118e7aad8
		summarizeBy: none
		sourceColumn: data_venda

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column nfe
		dataType: int64
		formatString: 0
		lineageTag: 2757e51e-0ebe-4c1c-a177-d38cafd3edc9
		summarizeBy: none
		sourceColumn: nfe

		annotation SummarizationSetBy = User

